rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product image uploads go through the Node.js backend (Admin SDK),
    // which bypasses these rules. Public read so product photos display
    // on the storefront; no direct client writes.
    match /products/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
