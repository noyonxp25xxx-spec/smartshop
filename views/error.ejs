<div class="wrap" style="padding: 80px 20px; text-align: center; max-width: 600px;">
  <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 48px 32px; box-shadow: var(--shadow-lg);">
    <div style="font-size: 56px; margin-bottom: 16px;">⚠️</div>
    <h1 style="font-family: var(--font-heading); font-size: 26px; font-weight: 800; margin-bottom: 12px; color: #FFFFFF;"><%= title %></h1>
    <p style="color: var(--text-secondary); font-size: 15px; margin-bottom: 28px; line-height: 1.6;"><%= message %></p>
    <a href="/" class="btn" style="padding: 12px 28px;">🏠 হোম পেজে ফিরে যান</a>
  </div>
</div>
