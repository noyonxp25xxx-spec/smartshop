<div class="wrap">
  <div class="admin-layout">
    <%- include('../partials/admin-sidebar', { active: 'products' }) %>

    <div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 14px;">
        <div>
          <h1 style="font-family: var(--font-heading); font-size: 26px; font-weight: 800;">
            সকল পণ্য ও স্টক তালিকা
          </h1>
          <p style="color: var(--text-secondary); font-size: 14px;">
            মোট <%= products.length %> টি পণ্য পাওয়া গেছে
          </p>
        </div>
        <a href="/admin/products/new" class="btn">
          ➕ নতুন পণ্য যোগ করুন
        </a>
      </div>

      <!-- Admin Table Search Filter -->
      <div style="margin-bottom: 16px;">
        <input 
          type="text" 
          id="adminTableFilter" 
          class="input-control" 
          placeholder="পণ্য ফিল্টার করুন (নাম, কোড, ক্যাটাগরি)..." 
          onkeyup="filterAdminTable()"
        />
      </div>

      <div class="table-responsive">
        <table class="admin-table" id="productsTable">
          <thead>
            <tr>
              <th>ছবি</th>
              <th>পণ্যের নাম</th>
              <th>ক্যাটাগরি</th>
              <th>কোড</th>
              <th>ক্রয় মূল্য</th>
              <th>বিক্রয় মূল্য</th>
              <th>স্টক</th>
              <th style="text-align: right;">অ্যাকশন</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function(p) { %>
              <tr class="product-row">
                <td style="width: 50px;">
                  <img src="<%= p.imageUrl %>" alt="<%= p.name %>" referrerpolicy="no-referrer" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1550745165-9bc0b252726f?w=800&auto=format&fit=crop&q=80';" style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-color);" />
                </td>
                <td>
                  <strong><%= p.name %></strong>
                </td>
                <td>
                  <span style="background: var(--bg-surface); padding: 3px 8px; border-radius: 4px; font-size: 12px;"><%= p.category || 'সাধারণ' %></span>
                </td>
                <td>
                  <% if (p.uniqueCode) { %>
                    <code style="background: rgba(0, 210, 255, 0.15); color: var(--accent-cyan); padding: 2px 6px; border-radius: 4px;">#<%= p.uniqueCode %></code>
                  <% } else { %>
                    <span style="color: var(--text-muted);">-</span>
                  <% } %>
                </td>
                <td style="color: #F87171; font-weight: 700;">৳<%= Number(p.buyPrice).toLocaleString('en-US') %></td>
                <td style="font-weight: 700; color: #FFFFFF;">৳<%= Number(p.sellPrice).toLocaleString('en-US') %></td>
                <td>
                  <div class="stock-stepper">
                    <button type="button" class="stock-step-btn" onclick="adjustStock('<%= p.id %>', -1, this)">−</button>
                    <span class="stock-num" id="stock-val-<%= p.id %>"><%= p.stock %></span>
                    <button type="button" class="stock-step-btn" onclick="adjustStock('<%= p.id %>', 1, this)">+</button>
                  </div>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <a href="/admin/products/<%= p.id %>/edit" class="btn btn-secondary btn-small" style="margin-right: 4px;">এডিট</a>
                  <button type="button" class="btn btn-danger btn-small" onclick="deleteProduct('<%= p.id %>')">মুছুন</button>
                </td>
              </tr>
            <% }) %>
            <% if (products.length === 0) { %>
              <tr>
                <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 40px;">
                  কোনো পণ্য পাওয়া যায়নি। নতুন পণ্য যোগ করুন।
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="/js/admin.js" defer></script>
<script>
  function filterAdminTable() {
    const input = document.getElementById('adminTableFilter');
    const filter = input.value.toLowerCase();
    const rows = document.querySelectorAll('.product-row');

    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      row.style.display = text.includes(filter) ? '' : 'none';
    });
  }
</script>
