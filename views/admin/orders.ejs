<div class="wrap">
  <div class="admin-layout">
    <%- include('../partials/admin-sidebar', { active: 'orders' }) %>

    <div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 14px;">
        <div>
          <h1 style="font-family: var(--font-heading); font-size: 26px; font-weight: 800;">
            🛒 গ্রাহক অর্ডার তালিকা
          </h1>
          <p style="color: var(--text-secondary); font-size: 14px;">
            ওয়েবসাইট থেকে কাস্টমারদের পাঠানো সকল ক্যাশ অন ডেলিভারি অর্ডারের তালিকা (Firebase Cloud Synced)
          </p>
        </div>
      </div>

      <% if (orders.length === 0) { %>
        <div class="empty-state">
          <div style="font-size: 48px; margin-bottom: 12px;">🛒</div>
          <h3 style="font-size: 18px; margin-bottom: 6px;">এখনও কোনো অর্ডার আসেনি</h3>
          <p style="color: var(--text-secondary); font-size: 14px;">কাস্টমাররা সরাসরি ওয়েবসাইট থেকে অর্ডার করলে তা এখানে প্রদর্শিত হবে।</p>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="admin-table">
            <thead>
              <tr>
                <th>অর্ডার আইডি ও তারিখ</th>
                <th>পণ্যের বিবরণ</th>
                <th>কাস্টমারের তথ্য</th>
                <th>মূল্য</th>
                <th>স্ট্যাটাস</th>
                <th>অ্যাকশন</th>
              </tr>
            </thead>
            <tbody>
              <% orders.forEach(function(o) { %>
                <tr>
                  <td>
                    <code style="background: rgba(0, 210, 255, 0.15); color: var(--accent-cyan); padding: 2px 6px; border-radius: 4px; font-weight: 600;">#<%= o.id %></code>
                    <div style="color: var(--text-muted); font-size: 12px; margin-top: 4px;">
                      <%= new Date(o.createdAt).toLocaleString('bn-BD', { timeZone: 'Asia/Dhaka' }) %>
                    </div>
                  </td>
                  <td>
                    <strong><%= o.productName %></strong>
                    <% if (o.productCode) { %>
                      <div style="color: var(--text-muted); font-size: 12px;">কোড: #<%= o.productCode %></div>
                    <% } %>
                  </td>
                  <td>
                    <strong style="color: #FFFFFF;"><%= o.customerName %></strong>
                    <div style="font-size: 13px; color: var(--accent-cyan); margin-top: 2px;">
                      <a href="tel:<%= o.phone %>" style="color: inherit; text-decoration: underline;">📞 <%= o.phone %></a>
                    </div>
                    <div style="font-size: 12px; color: var(--text-secondary); margin-top: 2px;">
                      📍 <%= o.address %>
                    </div>
                  </td>
                  <td style="font-weight: 700; color: var(--accent-emerald); font-size: 16px;">
                    ৳<%= Number(o.price).toLocaleString('en-US') %>
                  </td>
                  <td>
                    <% if (o.status === 'confirmed') { %>
                      <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.4);">কনফার্মড</span>
                    <% } else if (o.status === 'delivered') { %>
                      <span class="badge" style="background: rgba(59, 130, 246, 0.2); color: #60A5FA; border: 1px solid rgba(59, 130, 246, 0.4);">ডেলিভার্ড</span>
                    <% } else if (o.status === 'cancelled') { %>
                      <span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.4);">বাতিল</span>
                    <% } else { %>
                      <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.4);">অপেক্ষমান (Pending)</span>
                    <% } %>
                  </td>
                  <td>
                    <select class="input-control" style="padding: 4px 8px; font-size: 12px; width: auto;" onchange="updateOrderStatus('<%= o.id %>', this.value)">
                      <option value="pending" <%= o.status === 'pending' ? 'selected' : '' %>>অপেক্ষমান</option>
                      <option value="confirmed" <%= o.status === 'confirmed' ? 'selected' : '' %>>কনফার্মড</option>
                      <option value="delivered" <%= o.status === 'delivered' ? 'selected' : '' %>>ডেলিভার্ড</option>
                      <option value="cancelled" <%= o.status === 'cancelled' ? 'selected' : '' %>>বাতিল</option>
                    </select>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  async function updateOrderStatus(orderId, status) {
    try {
      const res = await fetch(`/admin/api/orders/${orderId}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
      });
      if (res.ok) {
        location.reload();
      } else {
        alert('অর্ডার স্ট্যাটাস পরিবর্তন করতে সমস্যা হয়েছে।');
      }
    } catch (e) {
      alert('নেটওয়ার্ক সমস্যা।');
    }
  }
</script>
