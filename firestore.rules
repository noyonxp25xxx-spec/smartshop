rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All reads/writes to products & users go through the Node.js backend
    // using the Firebase Admin SDK, which bypasses these rules entirely.
    // Direct client access is blocked here for security.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
